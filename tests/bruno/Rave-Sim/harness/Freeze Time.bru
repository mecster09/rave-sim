meta {
  name: Freeze Time
  type: http
  seq: 2
}

put {
  url: {{base-url}}/harness/time
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {"simStudyDay":2.5,"freeze":true}
}

vars:pre-request {
  base-url: http://localhost:3000
}

settings {
  encodeUrl: false
  timeout: 0
}
