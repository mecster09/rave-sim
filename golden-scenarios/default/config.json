{
  "harnessConfig": {
    "studyName": "Default Study",
    "siteCount": 2,
    "subjectCount": 10,
    "visitCountPerSubject": 3,
    "formDataPointsPerVisit": 5,
    "simSpeedMinutesPerDay": 60,
    "resetOnStartup": false,
    "randomSeed": 123456,
    "truncateOdm": false,
    "forceClinicalViewStreamFailure": false
  },
  "simStudyDay": 2.5,
  "freeze": true,
  "scenarios": [
    {
      "family": "clinical-view",
      "name": "regular-dataset",
      "request": {
        "method": "GET",
        "url": "/RaveWebServices/studies/Default%20Study/datasets/regular"
      }
    },
    {
      "family": "audit",
      "name": "clinical-records",
      "request": {
        "method": "GET",
        "url": "/RaveWebServices/datasets/ClinicalAuditRecords.odm?studyoid=Default%20Study&per_page=5"
      }
    },
    {
      "family": "datasets",
      "name": "raw-options",
      "outputFormat": "clinical-dataset-json",
      "request": {
        "method": "GET",
        "url": "/RaveWebServices/studies/Default%20Study/datasets/raw?start=2023-12-31T22:30:00Z&decodesuffix=_DEC&versionitem=VERSION"
      }
    },
    {
      "family": "datasets",
      "name": "versioned-regular",
      "request": {
        "method": "GET",
        "url": "/RaveWebServices/studies/Default%20Study/versions/V1/datasets/regular?start=2023-12-31T22:30:00Z&decodesuffix=_DEC&versionitem=VERSION"
      }
    },
    {
      "family": "datasets",
      "name": "versioned-raw",
      "outputFormat": "clinical-dataset-json",
      "request": {
        "method": "GET",
        "url": "/RaveWebServices/studies/Default%20Study/versions/V1/datasets/raw?start=2023-12-31T22:30:00Z&decodesuffix=_DEC&versionitem=VERSION"
      }
    }
  ]
}
